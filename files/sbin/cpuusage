#!/bin/sh

PPE_PATH="/sys/kernel/debug/ppe"

s1="$(grep '^cpu' /proc/stat)"
usleep 250000
s2="$(grep '^cpu' /proc/stat)"

cpu="$(printf '%s\n%s\n' "$s1" "$s2" | awk '
	{
		t = 0
		for (i = 2; i <= 9; i++) t += $i
		id = $5 + $6
		if (!($1 in T)) { T[$1] = t; I[$1] = id; next }
		dt = t - T[$1]
		u = (dt > 0) ? int((dt - (id - I[$1])) * 100 / dt + 0.5) : 0
		printf("%sCPU%s: %d%%", sep, substr($1, 4), u)
		sep = ", "
	}
')"
out="${cpu:-?}"

if [ -r "$PPE_PATH/entries" ]; then
	ppe="$(awk '
		function hex(s,   i, n) {
			n = 0
			s = tolower(s)
			for (i = 1; i <= length(s); i++)
				n = n * 16 + index("0123456789abcdef", substr(s, i, 1)) - 1
			return n
		}
		function seg(name, e) {
			return sprintf("%s: %d/%d %d/%d", name,
				b[e, "IPv4"], t[e, "IPv4"], b[e, "IPv6"], t[e, "IPv6"])
		}
		/^[0-9a-fA-F]+ / && ($3 == "IPv4" || $3 == "IPv6") {
			i = hex($1)
			e = (i < 8192) ? 0 : (i < 16384) ? 1 : 2
			t[e, $3]++
			if ($2 == "BND") b[e, $3]++
			dram += (e == 2)
		}
		END {
			printf("%s, %s", seg("PPE0", 0), seg("PPE1", 1))
			if (dram) printf(", %s", seg("DRAM", 2))
		}
	' "$PPE_PATH/entries" 2>/dev/null)"
	[ -n "$ppe" ] && out="$out
$ppe"
fi

printf '%s' "$out"
